{
  "name": "kabrubeach",
  "main": "worker/index.js",
  "compatibility_date": "2024-11-11",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ADMIN_USERNAME": "admin"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kabrubeach",
      "database_id": "fd785c2c-8d65-4ef7-a112-23c510933a95",
      "migrations_dir": "migrations"
    }
  ]
}
